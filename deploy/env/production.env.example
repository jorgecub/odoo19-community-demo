# On the server: /opt/odoo/env/production.env (mode 600). Never commit real values.
# Keep this on one line each. Generate secrets with: openssl rand -hex 32
ENV_NAME=production
ODOO_DB=odoo_production
POSTGRES_PASSWORD=
ADMIN_PASSWD=
ODOO_PROXY_MODE=True
ODOO_WORKERS=2
ODOO_CRON_THREADS=1
ODOO_MEM_LIMIT=4g
DB_MEM_LIMIT=2g
PG_SHARED_BUFFERS=1GB
