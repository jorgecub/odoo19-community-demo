# On the server: /opt/odoo/env/staging.env (mode 600). Never commit real values.
# Use different secrets from production. Generate with: openssl rand -hex 32
ENV_NAME=staging
ODOO_DB=odoo_staging
POSTGRES_PASSWORD=
ADMIN_PASSWD=
ODOO_PROXY_MODE=True
ODOO_WORKERS=2
ODOO_CRON_THREADS=1
ODOO_MEM_LIMIT=3g
DB_MEM_LIMIT=1500m
PG_SHARED_BUFFERS=512MB
